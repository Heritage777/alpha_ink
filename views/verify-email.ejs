<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container main-content verify-wrapper">
    <div class="form-container verify-card">
        <div class="form-header-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
        </div>

        <h2 class="form-heading">Verify Your Email</h2>
        <p class="form-subheading">Enter the 6-digit OTP sent to your email.</p>

        <form novalidate>
            <!-- Email -->
            <div class="form-group">
                <label for="email">Email</label>
                <input class="verify-email-input" type="email" name="email" id="email" placeholder="Enter your email" autocomplete="email" required>
            </div>

            <!-- OTP -->
            <div class="form-group">
                <label>OTP Verification Code</label>
                <div class="otp-container">
                    <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required>
                    <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input class="otp-input" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                </div>
            </div>

            <!-- Verify -->
            <button class="verify-btn btn-submit" type="submit">
                <span class="button-text">Verify Email</span>
                <span class="arrow">&rarr;</span>
            </button>

            <p class="error verify-error"></p>

            <!-- Resend & Timers -->
            <div class="resend-action-wrapper">
                <button type="button" class="resend-btn" disabled>Resend OTP</button>
            </div>

            <p class="resend-message"></p>
            <p class="otp-countdown"></p>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    const form = document.querySelector('form')
    const otpInputs = document.querySelectorAll('.otp-input')
    const errorMessage = document.querySelector('.verify-error')
    const resendButton = document.querySelector('.resend-btn')
    const resendMessage = document.querySelector('.resend-message')
    const countdownMessage = document.querySelector('.otp-countdown')

    // COUNTDOWN
    let countdownSeconds = 5 * 60
    let countdownTimer
    const updateCountdown = () => {
        const minutes = Math.floor(countdownSeconds / 60)
        const seconds = countdownSeconds % 60
        countdownMessage.textContent = `You can request a new OTP in ${minutes}:${seconds.toString().padStart(2, '0')}`
    }

    const startCountdown = () => {
        clearInterval(countdownTimer)
        countdownSeconds = 5 * 60
        resendButton.disabled = true
        updateCountdown()

        countdownTimer = setInterval(() => {
            countdownSeconds--
            updateCountdown()

            if (countdownSeconds <= 0) {
                clearInterval(countdownTimer)
                resendButton.disabled = false
                countdownMessage.textContent = 'Your OTP has expired. You can request a new one.'
            }
        }, 1000)
    }

    // OTP INPUT
    otpInputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            errorMessage.textContent = ''
            resendMessage.textContent = ''

            // Allow numbers only
            input.value = input.value.replace(/\D/g, '')

            // Move to next box
            if (input.value && index < otpInputs.length - 1) {otpInputs[index + 1].focus() }
        })

        // BACKSPACE
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace') {
                errorMessage.textContent = ''
                resendMessage.textContent = ''
                if (!input.value && index > 0) {
                    otpInputs[index - 1].focus()
                }
            }
        })
    })

    // EMAIL INPUT
    form.email.addEventListener('input', () => {
        errorMessage.textContent = ''
        resendMessage.textContent = ''
    })

    // VERIFY EMAIL
    form.addEventListener('submit', async (e) => {
        e.preventDefault()

        errorMessage.textContent = ''
        resendMessage.textContent = ''
        const email = form.email.value.trim()

        // Email validation
        if (!email) {
            errorMessage.textContent = 'Please enter your email.'
            form.email.focus()
            return
        }

        if (!form.email.validity.valid) {
            errorMessage.textContent = 'Please enter a valid email address.'
            form.email.focus()
            return
        }

        // Combine the six OTP boxes
        let otp = ''
        otpInputs.forEach((input) => {
            otp += input.value
        })

        // OTP validation
        if (otp.length !== 6) {
            errorMessage.textContent = 'Please enter the complete 6-digit OTP.'
            return
        }

        try {
            const response = await fetch('/verify-otp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email,
                    otp
                })
            })

            const data = await response.json()

            if (data.success) {
                window.location.href = data.redirect
            } else {
                errorMessage.textContent = data.message
            }
        } catch (error) {
            console.log(error)
            errorMessage.textContent = 'Something went wrong. Please try again.'
        }
    })

    // RESEND OTP
    resendButton.addEventListener('click', async () => {
        errorMessage.textContent = ''
        resendMessage.textContent = ''

        const email = form.email.value.trim()

        // Email validation
        if (!email) {
            resendMessage.textContent = 'Please enter your email first.'
            form.email.focus()
            return
        }

        if (!form.email.validity.valid) {
            resendMessage.textContent = 'Please enter a valid email address.'
            form.email.focus()
            return
        }

        try {
            resendButton.disabled = true
            resendButton.textContent = 'Sending...'

            const response = await fetch('/resend-otp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email
                })
            })

            const data = await response.json()

            if (data.success) {
                resendMessage.textContent = data.message

                // Clear old OTP
                otpInputs.forEach((input) => {
                    input.value = ''
                })

                otpInputs[0].focus()

                // Start a fresh 5-minute countdown
                startCountdown()
            } else {
                resendMessage.textContent = data.message
                resendButton.disabled = false
            }
        } catch (error) {
            console.log(error)
            resendMessage.textContent = 'Something went wrong. Please try again.'
            resendButton.disabled = false
        } finally {
            resendButton.textContent = 'Resend OTP'
        }
    })
    startCountdown()
</script>