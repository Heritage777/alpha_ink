<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="auth-wrapper change-password-page-wrapper">
    <div class="auth-main full-width-main">
        <div class="form-container">
            <div class="form-header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>

            <h2 class="form-heading">Change Password</h2>
            <p class="form-subheading">Update your password to keep your account secure</p>

            <form novalidate>
                <div class="form-group">
                    <label for="currentPassword">Current Password</label>
                    <input type="password" name="currentPassword" id="currentPassword" placeholder="Enter your current password" autocomplete="current-password" required>
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input type="password" name="newPassword" id="newPassword" placeholder="Enter your new password" autocomplete="new-password" required>
                </div>

                <div class="form-group">
                    <label for="passwordConfirm">Confirm New Password</label>
                    <input type="password" name="passwordConfirm" id="passwordConfirm" placeholder="Confirm your new password" autocomplete="new-password" required>
                </div>

                <button type="submit" class="btn-submit">
                    <span class="button-text">Change Password</span>
                    <span class="arrow">&rarr;</span>
                </button>

                <p class="error change-password-error"></p>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    const form = document.querySelector('form')
    const errorMessage = document.querySelector('.change-password-error')
    const currentPassword = document.querySelector('#currentPassword')
    const newPassword = document.querySelector('#newPassword')
    const passwordConfirm = document.querySelector('#passwordConfirm')

    form.addEventListener('submit', async (e) => {
        e.preventDefault()
        errorMessage.textContent = ''
        if (!currentPassword.value) {
            errorMessage.textContent = 'Please enter your current password.'
            currentPassword.focus()
            return
        }
        if (!newPassword.value) {
            errorMessage.textContent = 'Please enter a new password.'
            newPassword.focus()
            return
        }

        if (newPassword.value.length < 6) {
            errorMessage.textContent = 'New password must be at least 6 characters.'
            newPassword.focus()
            return
        }

        if (!passwordConfirm.value) {
            errorMessage.textContent = 'Please confirm your new password.'
            passwordConfirm.focus()
            return
        }

        if (newPassword.value !== passwordConfirm.value) {
            errorMessage.textContent = 'New passwords do not match.'
            passwordConfirm.focus()
            return
        }
        try {
            const response = await fetch('/change-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json'},
            body: JSON.stringify({
                currentPassword: currentPassword.value,
                newPassword: newPassword.value,
                passwordConfirm: passwordConfirm.value
            })
        })

        const data = await response.json()
        if (data.success) { window.location.href = data.redirect }
        else { errorMessage.textContent = data.message }
    } 
    catch (error) {
        console.log(error)
        errorMessage.textContent = 'Something went wrong. Please try again.' }
    })

    form.addEventListener('input', () => { errorMessage.textContent = '' })
</script>