<%- include('./partials/head.ejs') %>
<!-- Navigation Bar -->
<%- include('./partials/nav.ejs') %>

<!-- Main Content Container (Single Top-to-Bottom Flow) -->
<div class="container main-content about-page-wrapper">
    <header class="page-header">
        <div class="about-badge">Platform Overview</div>
        <h1>About Alpα_ink</h1>
        <p>A production-ready, full-stack server-rendered blogging platform built from scratch.</p>
    </header>

    <div class="about-card">
        <section class="about-section">
            <h3>Project Overview & Vision</h3>
            <p>
                <strong>Alpα_ink</strong> is a robust, custom-built web application engineered using Node.js, Express, and EJS. Designed as a complete full-stack portfolio project, it moves away from managed BaaS solutions to maintain absolute control over server-side architecture, custom routing, middleware layers, database schemas, and data security workflows.
            </p>
        </section>

        <section class="about-section">
            <h3>Core Features Implemented</h3>
            
            <div class="feature-grid">
                <div class="feature-category">
                    <div class="feature-icon">🔒</div>
                    <h4>1. Authentication & Security</h4>
                    <ul class="tech-list">
                        <li><strong>Secure Auth:</strong> JWT-based authentication stored securely in HTTP-only cookies with protected route middleware.</li>
                        <li><strong>Credential Protection:</strong> Password hashing via bcrypt and unique username/email validation.</li>
                        <li><strong>Account Verification:</strong> Email verification using OTPs sent via Nodemailer with token expiration.</li>
                    </ul>
                </div>

                <div class="feature-category">
                    <div class="feature-icon">🖼️</div>
                    <h4>2. Profile & Media Management</h4>
                    <ul class="tech-list">
                        <li><strong>Cloud Storage:</strong> Profile picture uploads managed via Multer and stored remotely on Cloudinary, tracked in MongoDB.</li>
                        <li><strong>Lifecycle Cleanup:</strong> Automatic removal of temporary server-side files post-upload.</li>
                    </ul>
                </div>

                <div class="feature-category">
                    <div class="feature-icon">✍️</div>
                    <h4>3. Blog Post Lifecycle (CRUD)</h4>
                    <ul class="tech-list">
                        <li><strong>Protected Operations:</strong> Users can create, view, edit, and delete their own blog posts backed by strict ownership validation.</li>
                    </ul>
                </div>

                <div class="feature-category">
                    <div class="feature-icon">⚡</div>
                    <h4>4. Architecture & Tech Stack</h4>
                    <ul class="tech-list">
                        <li><strong>Server & Engine:</strong> Express.js routing engine paired with dynamic EJS server-side rendering.</li>
                        <li><strong>Database:</strong> MongoDB Atlas managed through structured Mongoose models.</li>
                    </ul>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Footer -->
