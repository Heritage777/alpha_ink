<%- include('./partials/head') %>
<%- include('./partials/nav') %>

<div class="auth-wrapper">
    <!-- Left Side: Ambient Branding Panel -->
    <div class="auth-sidebar">
        <div class="brand-content">
            <div class="brand-badge">Alpha_Ink Portal</div>
            <h1>Welcome<br />Back</h1>
            <p> Glad to see you again. Let's continue where you left off crafting your ideas.</p>
        </div>
    </div>

    <!-- Right Side: Login Card Form -->
    <div class="auth-main">
        <div class="form-container">

            <div class="form-header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5-10 5v10l10 5 10-5" />
                </svg>
            </div>

            <h2 class="form-heading">Login</h2>
            <p class="form-subheading"> Enter your credentials to access your account </p>

            <form action="/login" method="POST" data-loading-text="Logging in..." novalidate>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" name="email" id="email" placeholder="you@example.com" autocomplete="email" required>
                    <p class="error email"></p>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>

                    <div class="password-wrapper">
                        <input type="password" name="password" id="password" placeholder="••••••••" autocomplete="current-password" required>
                    </div>

                    <p class="error password"></p>
                </div>

                <div class="form-actions-inline">
                    <a href="/forgot-password" class="forgot-link">Forgot Password?</a>
                    <a href="/verify-email" class="forgot-link">Verify Email</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-submit" id="loginButton">
                    <span class="button-text">Login</span>
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span class="arrow">&rarr;</span>
                </button>

                <div class="auth-footer-text">
                    Don't have an account?
                    <a href="/signup">Sign up</a>
                </div>

            </form>
        </div>
    </div>

</div>

<%- include('./partials/footer') %>

<style>
    /* Typewriter Header Styles */
    .typewriter-header {
        min-height: 1.4em;
        display: inline-block;
    }
    .typed-text {
        font-weight: inherit;
    }
    .cursor {
        display: inline-block;
        background-color: currentColor;
        margin-left: 2px;
        width: 3px;
        animation: blink 0.8s infinite;
    }
    @keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const typedTextSpan = document.querySelector(".page-header .typed-text")
        const textArray = [
            "Share your thoughts...",
            "Display your genius...",
            "Craft your ideas."
        ]
        const typingDelay = 60
        const erasingDelay = 35
        const newTextDelay = 1500
        let textArrayIndex = 0
        let charIndex = 0
       
        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex)
                charIndex++
                setTimeout(type, typingDelay)
            } else { setTimeout(erase, newTextDelay) }
        }

        function erase() {
            if (charIndex > 0) {
                typedTextSpan.textContent = textArray[textArrayIndex].substring( 0, charIndex - 1 )
                charIndex--
                setTimeout(erase, erasingDelay)
            } else {
                textArrayIndex++
                if (textArrayIndex >= textArray.length) { textArrayIndex = 0 }
                setTimeout(type, typingDelay + 400)
            }
        }
        if (textArray.length && typedTextSpan) {
            setTimeout( type, newTextDelay + 250 )
        }
    })

    // UPDATE LIKE COUNT
    function updateLikeCountFromStorage() {
        const storedLike = sessionStorage.getItem( 'alphaInkLikeUpdate' )
        if (!storedLike) {return}
        try {
            const likeData = JSON.parse(storedLike)
            const likeCountElement = document.querySelector( `.blog-like-count[data-blog-id="${likeData.blogId}"]`)
            if (likeCountElement) {
                likeCountElement.innerHTML = `❤️ ${likeData.likes}`
            }
            // Remove the temporary update
            sessionStorage.removeItem( 'alphaInkLikeUpdate' )

        } catch (error) {
            console.log('Could not update like count:', error )
            sessionStorage.removeItem( 'alphaInkLikeUpdate')

        }

    }

    // RUN WHEN RETURNING TO BLOGS PAGE
    window.addEventListener( 'pageshow', () => { updateLikeCountFromStorage()} )
</script>