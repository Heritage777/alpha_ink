
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="auth-wrapper">

    <!-- Left Side: Ambient Branding Panel -->
    <div class="auth-sidebar">
        <div class="brand-content">
            <div class="brand-badge">Alpha_Ink Portal</div>

            <h1>Join Our<br>Community</h1>

            <p>
                Create an account to start sharing your stories
                and engaging with other writers.
            </p>
        </div>
    </div>

    <!-- Right Side: Signup Card Form -->
    <div class="auth-main">
        <div class="form-container">

            <div class="form-header-icon">
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <line x1="20" y1="8" x2="20" y2="14"></line>
                    <line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>

            <h2 class="form-heading">Sign Up</h2>

            <p class="form-subheading">
                Create your account to get started
            </p>

            <form action="/signup" method="POST" novalidate>

                <div class="form-group">
                    <label for="username">Username</label>

                    <input
                        type="text"
                        name="username"
                        id="username"
                        placeholder="Enter your username"
                        autocomplete="username"
                        required
                    />

                    <p class="error username"></p>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>

                    <input
                        type="email"
                        name="email"
                        id="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        required
                    />

                    <p class="error email"></p>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        placeholder="••••••••"
                        autocomplete="new-password"
                        required
                    />

                    <p class="error password"></p>
                </div>

                <div class="form-group">
                    <label for="passwordConfirm">
                        Confirm Password
                    </label>

                    <input
                        type="password"
                        name="passwordConfirm"
                        id="passwordConfirm"
                        placeholder="••••••••"
                        autocomplete="new-password"
                        required
                    />

                    <p class="error passwordConfirm"></p>
                </div>

                <!-- Submit Button -->
                <button
                    type="submit"
                    class="btn-submit"
                    id="signupButton"
                >
                    <span class="button-text">Create Account</span>

                    <span
                        class="button-spinner"
                        aria-hidden="true"
                    ></span>

                    <span class="arrow">&rarr;</span>
                </button>

                <div class="auth-footer-text">
                    Already have an account?
                    <a href="/login">Login</a>
                </div>

            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
    const form = document.querySelector('form');

    const emailError = document.querySelector('.email.error');
    const passwordError = document.querySelector('.password.error');
    const passwordConfirmError =
        document.querySelector('.passwordConfirm.error');
    const usernameError = document.querySelector('.username.error');

    const submitButton = document.getElementById('signupButton');

    const buttonText = submitButton.querySelector('.button-text');
    const arrow = submitButton.querySelector('.arrow');

    const originalButtonText = 'Create Account';

    // Show loading state
    function showLoading() {
        submitButton.disabled = true;

        submitButton.classList.add('is-loading');

        buttonText.textContent = 'Creating account...';

        arrow.style.display = 'none';
    }

    // Restore button after a failed request
    function hideLoading() {
        submitButton.disabled = false;

        submitButton.classList.remove('is-loading');

        buttonText.textContent = originalButtonText;

        arrow.style.display = '';
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Clear previous errors
        emailError.textContent = '';
        passwordError.textContent = '';
        passwordConfirmError.textContent = '';
        usernameError.textContent = '';

        const username = form.username.value.trim();
        const email = form.email.value.trim();
        const password = form.password.value;
        const passwordConfirm = form.passwordConfirm.value;

        // Basic frontend validation
        if (!username || !email || !password || !passwordConfirm) {

            if (!username) {
                usernameError.textContent =
                    'Please enter a username.';
            }

            if (!email) {
                emailError.textContent =
                    'Please enter your email address.';
            }

            if (!password) {
                passwordError.textContent =
                    'Please enter a password.';
            }

            if (!passwordConfirm) {
                passwordConfirmError.textContent =
                    'Please confirm your password.';
            }

            return;
        }

        // Start loading
        showLoading();

        try {
            const result = await fetch('/signup', {
                method: 'POST',

                body: JSON.stringify({
                    username,
                    email,
                    password,
                    passwordConfirm
                }),

                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await result.json();

            console.log(data);

            // Handle validation errors
            if (data.errors) {
                usernameError.textContent =
                    data.errors.username || '';

                emailError.textContent =
                    data.errors.email || '';

                passwordError.textContent =
                    data.errors.password || '';

                passwordConfirmError.textContent =
                    data.errors.passwordConfirm || '';
            }

            // Successful signup
            if (data.success) {
                buttonText.textContent = 'Account created!';

                window.location.assign(data.redirect);

                return;
            }

            // Signup failed
            hideLoading();

        } catch (error) {
            console.error('Signup request failed:', error);

            emailError.textContent =
                'Unable to connect. Please check your internet and try again.';

            hideLoading();
        }
    });
</script>